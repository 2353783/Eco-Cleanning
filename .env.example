# ========================================================
# ECO CLEAN RDC - CONFIGURATION FIREBASE (OPTIONNELLE)
# ========================================================
# Si vous souhaitez relier l'application à un projet Google Firebase,
# copiez ce fichier en '.env' et complétez les valeurs depuis la console Firebase :
# https://console.firebase.google.com

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=eco-clean-rdc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=eco-clean-rdc
VITE_FIREBASE_STORAGE_BUCKET=eco-clean-rdc.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

